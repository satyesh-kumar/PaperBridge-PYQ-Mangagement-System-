# ── SERVER CONFIGURATION ──────────────────────────────────────────────────────
PORT=5000
ALLOWED_ORIGIN=https://paper-bridge-pyq-mangagement-system.vercel.app,http://localhost:5173
APP_BASE_URL=https://paper-bridge-pyq-mangagement-system.vercel.app

# ── DATABASE ──────────────────────────────────────────────────────────────────
MONGO_URL=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/PaperBridge?retryWrites=true&w=majority

# ── AUTHENTICATION (CLERK) ────────────────────────────────────────────────────
CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxx

# ── STORAGE (CLOUDINARY) ──────────────────────────────────────────────────────
CLOUDINARY_NAME=your_cloud_name
CLOUDINARY_KEY=your_cloudinary_key
CLOUDINARY_SECRET=your_cloudinary_secret

# ── ADMIN AUTHORIZATION ───────────────────────────────────────────────────────
ADMIN_EMAILS=admin@paperbridge.com,satyeshkumar578@gmail.com

# ── TRANSACTIONAL EMAIL NOTIFICATIONS (FEEDBACK SYSTEM) ──────────────────────
# Destination email for new feedback submission alerts (defaults to first email in ADMIN_EMAILS)
FEEDBACK_ADMIN_EMAIL=admin@paperbridge.com

# Sender display name & address
EMAIL_FROM="PaperBridge Platform" <notifications@paperbridge.com>

# Optional SMTP Settings (if using SMTP provider like SendGrid, Mailgun, Amazon SES, Brevo, Gmail, etc.)
# If left empty, system runs safely in simulation/logged mode without failing feedback submissions
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_username@gmail.com
SMTP_PASS=your_smtp_app_password
